%%%%** Section 6
\section{Scheduling Summary}


\begin{tabular}{|p{1.75in}|p{1.75in}|}\hline
Issue                   & Scheduling Concepts    \\ \hline
How often will each task run? & Task types; Round Robin ; delay functions      \\ \hline
Which task runs next?         & Task State; Round Robin; Priority Schemes   \\\hline
How do tasks give up CPU?       & {\tt return()/yield()} ; Request I/O ; interrupts/preemption\\\hline
What if task doesn't need to run all the time? & {\tt  dynamic scheduling ; halt\_me()/start(task)} \\\hline
How can we meet deadlines {\bf and} make full use of CPU? & Background Tasks \\\hline
\end{tabular}


<s>\end{slide}
<s>\begin{slide}

%%%%** Section 7
\section{RTOS Types}

{\tt
\begin{tabular}{|l|c|c|c|}\hline
Type            & $C$               & $D$           & Scheduling        \\\hline
``Super HRT''   &  $\ll P$    & P             & Trivial           \\ \hline
``Hard RT''     &  $(1 \sim 5)T$        & $(10 \sim 20)T$        & Complex      \\ \hline
``Soft RT''     &  $(10 \sim 20)T$       & $\sim100T$    & Complex          \\ \hline
Non RT          &   X               & X             & Trivial           \\ \hline
\end{tabular}
}

<s> $P = $task period; $C =$ Compute Time; $D =$Deadline; $T =$ Time Quantum
<hn>Where $P,C,D,T$ are defined in sections \ref{Periodic} and \ref{Time}.

<s>\end{slide}

